  },
  {
    "id": "wu_disable_speech_model_update",
    "name": "Disable Automatic Speech Model Updates",
    "description": "Stops Windows downloading updated speech recognition models in the background.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Speech",

[
  {
    "id": "wu_notify_before_download",
    "name": "Notify Before Downloading Updates",
    "description": "Makes Windows Update ask before it downloads and installs anything, instead of doing both on its own schedule. You still get told an update exists.",
    "category": "Windows Update",
    "risk": "medium",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "NoAutoUpdate",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "AUOptions",
        "data": 2,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_download_but_notify_install",
    "name": "Download Updates but Ask Before Installing",
    "description": "Lets Windows fetch updates in the background but hold off installing until you say so. A reasonable middle ground: nothing reboots unexpectedly, and the download is already done when you agree.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "NoAutoUpdate",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "AUOptions",
        "data": 3,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_restore_automatic_updates",
    "name": "Restore Fully Automatic Updates",
    "description": "Removes the automatic-update policy overrides so Windows Update goes back to downloading and installing on its own. This is the safest configuration for a machine nobody watches.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "NoAutoUpdate"
      },
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "AUOptions"
      }
    ]
  },
  {
    "id": "wu_no_reboot_with_users_logged_on",
    "name": "Never Reboot While Someone Is Signed In",
    "description": "Stops Windows Update restarting the machine automatically while a user session is active. The restart waits for you to do it yourself.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "value": "NoAutoRebootWithLoggedOnUsers",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_restart_notifications",
    "name": "Disable Restart Reminder Notifications",
    "description": "Silences the recurring 'restart to finish installing updates' toasts. The update still installs at the next restart.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "value": "RestartNotificationsAllowed2",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_defer_feature_updates_365",
    "name": "Defer Feature Updates for a Year",
    "description": "Holds back new Windows versions for 365 days while still taking monthly security fixes. This is how you stay on a known-good build without going unpatched.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferFeatureUpdates",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferFeatureUpdatesPeriodInDays",
        "data": 365,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "BranchReadinessLevel",
        "data": 16,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_defer_quality_updates_7",
    "name": "Defer Quality Updates for a Week",
    "description": "Delays monthly cumulative updates by seven days, which is long enough for a bad patch to be pulled before it reaches this machine.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferQualityUpdates",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferQualityUpdatesPeriodInDays",
        "data": 7,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_clear_all_deferrals",
    "name": "Clear All Update Deferrals",
    "description": "Removes the feature and quality update deferral policies so this PC takes updates on Microsoft's normal schedule again.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferFeatureUpdates"
      },
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferFeatureUpdatesPeriodInDays"
      },
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferQualityUpdates"
      },
      {
        "type": "registry_delete",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DeferQualityUpdatesPeriodInDays"
      }
    ]
  },
  {
    "id": "wu_exclude_driver_updates",
    "name": "Exclude Drivers From Windows Update",
    "description": "Stops Windows Update replacing your GPU, audio and chipset drivers with its own generic versions. Strongly recommended if you install vendor drivers yourself.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "ExcludeWUDriversInQualityUpdate",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\DriverSearching",
        "value": "SearchOrderConfig",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_device_metadata_download",
    "name": "Stop Downloading Device Icons and Metadata",
    "description": "Prevents Windows fetching manufacturer icons and friendly names for attached hardware from the internet. Devices still work; they just show generic icons.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Metadata",
        "value": "PreventDeviceMetadataFromNetwork",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_delivery_optimization_p2p",
    "name": "Disable Peer-to-Peer Update Sharing",
    "description": "Stops Delivery Optimization uploading update content to other PCs over the internet and downloading from them. Updates come from Microsoft only, which saves upstream bandwidth on a metered or slow connection.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "value": "DODownloadMode",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_delivery_optimization_lan_only",
    "name": "Limit Update Sharing to the Local Network",
    "description": "Lets Delivery Optimization share update content with other PCs on your LAN but never over the internet. A good setting for a household with several Windows machines.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "value": "DODownloadMode",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_dual_scan",
    "name": "Stop Reaching the Internet When a WSUS Server Is Set",
    "description": "Prevents Windows Update contacting Microsoft directly for feature updates when the machine is pointed at an internal WSUS server. Only meaningful in a managed environment.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "applies_to": {
      "requires_gpedit": true
    },
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "DoNotConnectToWindowsUpdateInternetLocations",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_auto_restart_signon",
    "name": "Do Not Reopen Apps After an Update Restart",
    "description": "Stops Windows automatically signing you back in and reopening your apps after an update-triggered restart. Removes an unattended auto-logon window.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
        "value": "DisableAutomaticRestartSignOn",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "value": "DisableAutomaticRestartSignOn",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_set_active_hours",
    "name": "Set Active Hours to 8am–11pm",
    "description": "Tells Windows Update the machine is in use between 08:00 and 23:00, so it will not restart for updates during that window.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "value": "ActiveHoursStart",
        "data": 8,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "value": "ActiveHoursEnd",
        "data": 23,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "value": "SmartActiveHoursState",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_other_microsoft_products",
    "name": "Do Not Update Other Microsoft Products",

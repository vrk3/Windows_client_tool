  {
    "id": "wu_disable_windows_update_medic",
    "name": "Disable the Update Medic Service",
    "description": "Stops WaaSMedicSvc, the watchdog whose job is to undo changes to Windows Update configuration. Its key is ACL-protected, so this may be refused even as Administrator.",
    "category": "Windows Update",
    "risk": "high",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\WaaSMedicSvc",
        "value": "Start",
        "data": 4,
        "kind": "DWORD"
      }
    ]
  }
]

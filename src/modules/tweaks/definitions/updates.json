        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_enable_store_auto_updates",
    "name": "Enable Automatic Microsoft Store App Updates",
    "description": "Lets the Store keep installed apps up to date on its own, which is where security fixes for Store apps arrive.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsStore",
        "value": "AutoDownload",
        "data": 4,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_auto_reboot_task",
    "name": "Disable the Update Reboot Scheduled Task",
    "description": "Disables the UpdateOrchestrator Reboot task, one of the mechanisms behind an unattended restart. Windows may re-enable this task after a feature update.",
    "category": "Windows Update",
    "risk": "medium",
    "requires_admin": true,
    "steps": [
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\UpdateOrchestrator\\Reboot"
      }
    ]
  },
  {
    "id": "wu_disable_scheduled_start_task",
    "name": "Disable the Update Scheduled Start Task",
    "description": "Disables the UpdateOrchestrator Scheduled Start task that wakes the update stack on its own timetable.",
    "category": "Windows Update",
    "risk": "medium",
    "requires_admin": true,
    "steps": [
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\UpdateOrchestrator\\Schedule Scan"
      }
    ]
  },
  {
    "id": "wu_disable_onesettings_refresh",
    "name": "Disable the OneSettings Configuration Refresh Task",
    "description": "Disables the scheduled task that periodically pulls Microsoft's OneSettings configuration blob, which is how feature flags and experiments are pushed to this machine between updates.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\Flighting\\OneSettings\\RefreshCache"
      }
    ]
  },
  {
    "id": "wu_disable_update_toast_ads",
    "name": "Disable Post-Update Feature Advertisements",
    "description": "Stops Windows advertising new features and Microsoft services in the update pages and follow-up notifications after installing an update.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "value": "DisableWindowsConsumerFeatures",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement",
        "value": "ScoobeSystemSettingEnabled",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_set_metered_connection_block",
    "name": "Never Download Updates Over a Metered Connection",
    "description": "Stops Windows Update using a connection you have marked as metered, which is what keeps a tethered phone plan from being spent on a cumulative update.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "value": "AllowAutoWindowsUpdateDownloadOverMeteredNetwork",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "wu_disable_maps_auto_update",
    "name": "Disable Automatic Offline Maps Updates",
    "description": "Stops Windows downloading offline map data in the background. Only matters if you have downloaded offline maps at all.",
    "category": "Windows Update",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",

[
  {
    "id": "def_enable_pua_protection",
    "name": "Block Potentially Unwanted Applications",
    "description": "Turns on Defender's PUA blocking, which catches adware, bundleware and the 'free download manager' class of software that is not quite malware but is never wanted. One of the highest-value Defender settings that is off by default on some builds.",
    "category": "Defender & Firewall",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender",
        "value": "PUAProtection",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\MpEngine",
        "value": "MpEnablePus",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "def_enable_network_protection",
    "name": "Enable Network Protection",
    "description": "Blocks outbound connections to domains Microsoft knows to be malicious, across every browser and application rather than just Edge.",

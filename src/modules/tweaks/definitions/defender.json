  },
  {
    "id": "def_enable_controlled_folder_access",
    "name": "Enable Controlled Folder Access (Anti-Ransomware)",
    "description": "Stops untrusted programs writing to Documents, Pictures and other protected folders. This is Defender's ransomware defence. Expect to have to allow-list legitimate apps such as backup tools and games that save into Documents.",

[
  {
    "id": "disable_remote_desktop",
    "name": "Disable Remote Desktop (RDP)",
    "description": "Prevents inbound RDP connections. Closes port 3389. Recommended unless you actively use RDP to connect to this machine.",
    "category": "Security",
    "risk": "medium",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server",
        "value": "fDenyTSConnections",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
        "value": "UserAuthentication",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_remote_assistance",
    "name": "Disable Remote Assistance",
    "description": "Prevents anyone from remotely controlling this machine via Remote Assistance (msra.exe).",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
        "value": "fAllowToGetHelp",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_uac_max",
    "name": "Set UAC to Maximum Level",
    "description": "Enables the highest UAC prompt level — always prompt, even for built-in admins. Best practice on any workstation.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "EnableLUA",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "ConsentPromptBehaviorAdmin",
        "data": 2,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "PromptOnSecureDesktop",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_llmnr",
    "name": "Disable LLMNR (Link-Local Multicast Name Resolution)",
    "description": "LLMNR is exploited by MITM attacks (Responder tool). Disable unless you're on a legacy network that requires it.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
        "value": "EnableMulticast",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_netbios_tcpip",
    "name": "Disable NetBIOS over TCP/IP (via policy)",
    "description": "Disables NetBIOS name resolution. Removes NBT-NS, which is used in Responder/MITM attacks on local networks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters",
        "value": "NodeType",
        "data": 2,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_firewall_all_profiles",
    "name": "Ensure Windows Firewall is Enabled (All Profiles)",
    "description": "Enables Windows Firewall for Domain, Private, and Public profiles. Safe default — should never be disabled.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
        "value": "EnableFirewall",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\StandardProfile",
        "value": "EnableFirewall",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
        "value": "EnableFirewall",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_smb1",
    "name": "Disable SMBv1 Protocol",
    "description": "Disables the legacy SMBv1 protocol exploited by WannaCry/EternalBlue. Safe on any modern Windows — SMBv2/3 handles all modern file sharing.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
        "value": "SMB1",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "powershell_restricted_policy",
    "name": "Set PowerShell Execution Policy to RemoteSigned",
    "description": "Requires downloaded scripts to be signed by a trusted publisher. Allows local scripts. Balanced security without breaking automation.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell",
        "value": "EnableScripts",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell",
        "value": "ExecutionPolicy",
        "data": "RemoteSigned",
        "kind": "SZ"
      }
    ]
  },
  {
    "id": "enable_ps_script_block_logging",
    "name": "Enable PowerShell Script Block Logging",
    "description": "Logs all PowerShell script blocks to the Windows event log. Invaluable for detecting malicious scripts. Slight overhead on PS-heavy systems.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging",
        "value": "EnableScriptBlockLogging",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_wpad_autodetect",
    "name": "Disable WPAD Auto-Proxy Discovery",
    "description": "Prevents Windows from auto-discovering proxy settings via WPAD. WPAD is exploited for MITM proxy injection attacks on untrusted networks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": false,
    "steps": [
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings",
        "value": "AutoDetect",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_office_macros",
    "name": "Disable Office Macros (if Office installed)",
    "description": "Blocks all VBA macros in Office documents except those digitally signed. #1 attack vector for corporate malware. No impact if you never use macros.",
    "category": "Security",
    "risk": "medium",
    "requires_admin": false,
    "steps": [
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Office\\16.0\\Word\\Security",
        "value": "VBAWarnings",
        "data": 3,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Office\\16.0\\Excel\\Security",
        "value": "VBAWarnings",
        "data": 3,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Office\\16.0\\PowerPoint\\Security",
        "value": "VBAWarnings",
        "data": 3,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_sticky_keys_backdoor",
    "name": "Harden Accessibility Feature Backdoor (Sticky Keys)",
    "description": "Replaces the Sticky Keys / Ease of Access shortcut executables with a disabled flag. These are abused to get a SYSTEM shell from the login screen.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe",
        "value": "Debugger",
        "data": "",
        "kind": "SZ"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\utilman.exe",
        "value": "Debugger",
        "data": "",
        "kind": "SZ"
      }
    ]
  },
  {
    "id": "disable_autorun_all_drives",
    "name": "Disable AutoRun on All Drive Types",
    "description": "Prevents AutoRun from executing content on USB drives, CDs, DVDs, and network shares. Blocks a classic malware delivery vector.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
        "value": "NoDriveTypeAutoRun",
        "data": 255,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
        "value": "NoDriveTypeAutoRun",
        "data": 255,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "restrict_anonymous_access",
    "name": "Restrict Anonymous Network Access (Null Sessions)",
    "description": "Prevents unauthenticated users from enumerating shares, user accounts, and SAM data over the network. Hardens against network reconnaissance attacks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
        "value": "RestrictAnonymous",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
        "value": "RestrictAnonymousSAM",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "require_ctrl_alt_del",
    "name": "Require Ctrl+Alt+Del at Login",
    "description": "Forces the secure attention sequence before the login prompt. Prevents spoofed login screens from harvesting credentials.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "DisableCAD",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "clear_pagefile_on_shutdown",
    "name": "Clear Pagefile on Shutdown",
    "description": "Zeros the pagefile during a clean shutdown. Prevents sensitive data (passwords, keys, tokens) from being recovered from the pagefile after shutdown. Adds ~30 seconds to shutdown time.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management",
        "value": "ClearPageFileAtShutdown",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "require_smb_signing",
    "name": "Require SMB Signing on Workstation",
    "description": "Mandates cryptographic signing on all outbound SMB connections. Blocks SMB relay attacks where an attacker intercepts and replays authentication tokens on the local network.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
        "value": "RequireSecuritySignature",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
        "value": "EnableSecuritySignature",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_credential_guard",
    "name": "Enable Windows Defender Credential Guard",
    "description": "Enables Credential Guard to isolate the Local Security Authority (LSASS) process using Virtualisation-Based Security. Prevents credential theft via memory dumping attacks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard",
        "value": "EnableVirtualizationBasedSecurity",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard",
        "value": "RequirePlatformSecurityFeatures",
        "data": 3,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_remote_cad",
    "name": "Disable Remote Scheduled Tasks (ATS)",
    "description": "Disables the Remote Registry server task. Prevents remote machines from querying the registry of this PC.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\Registry\\RegIdleBackup"
      },
      {
        "type": "service",
        "name": "RemoteRegistry",
        "start_type": "disabled"
      }
    ]
  },
  {
    "id": "enable_exploit_protection",
    "name": "Enable Exploit Protection (Memory Protection)",
    "description": "Enables all Windows Defender Exploit Protection memory mitigations: Control Flow Guard, Data Execution Prevention, and Randomised Memory Layouts.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "command",
        "cmd": "powershell -Command \"Set-ProcessMitigation -System -Enable CFG,SEHOP,HeapTerminate,BottomUp,HighEntropy,ExtensionPoint\""
      }
    ],
    "detect": {
      "type": "powershell",
      "script": "try { $m = Get-ProcessMitigation -System -ErrorAction Stop; if ($m.Cfg.Enable -eq 'ON') {'True'} else {'False'} } catch { 'error' }",
      "applied_when": "True",
      "applied_reason": "system-wide CFG mitigation is on",
      "not_applied_reason": "system-wide CFG mitigation is off"
    }
  },
  {
    "id": "disable_admin_shares",
    "name": "Disable Administrative Shares",
    "description": "Prevents Windows from creating default admin shares (C$, ADMIN$) on boot. Reduces the number of exposed network endpoints on domain-joined machines.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
        "value": "AutoShareWks",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_nla",
    "name": "Require Network Level Authentication (NLA) for RDP",
    "description": "Requires the user to authenticate before a remote desktop session is established. Prevents DoS attacks that exhaust server resources with unauthenticated connections.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
        "value": "UserAuthentication",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
        "value": "SecurityLayer",
        "data": 2,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_print_spooler_rpc",
    "name": "Restrict Print Spooler RPC to Authenticated Clients",
    "description": "Sets RegisterSpoolerRemoteRpcEndPoint to 2, which stops the print spooler from listening for remote RPC connections — the exposure behind the PrintNightmare class of bugs. Local printing is unaffected.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Printers",
        "value": "RegisterSpoolerRemoteRpcEndPoint",
        "data": 2,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_lanman_workstation",
    "name": "Disable LAN Manager (LM) Authentication",
    "description": "Prevents the use of the legacy LAN Manager authentication protocol which uses weak DES keys. Modern NTLMv2 is always used when LM is disabled.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
        "value": "LmCompatibilityLevel",
        "data": 5,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_aslr_strict",
    "name": "Enable Force ASLR",
    "description": "Forces all executables to use Address Space Layout Randomisation even if they were not compiled with /DYNAMICBASE. Closes a gap exploited by return-oriented programming attacks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management",
        "value": "MoveImages",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_ipv6_router_discovery",
    "name": "Disable IPv6 Router Discovery",
    "description": "Prevents the machine from accepting router advertisements. IPv6 routing is disabled unless manually configured — useful for isolating the machine on IPv6 networks.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
        "value": "RouterDiscovery",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "secure_windows_defender",
    "name": "Enable Windows Defender Hardening",
    "description": "Enables all Defender policy-based hardening: real-time behaviour monitoring, script scanning, and cloud-delivered protection.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection",
        "value": "DisableRealtimeMonitoring",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection",
        "value": "DisableIOAVProtection",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\SmartScreen",
        "value": "EnableSmartScreen",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_smbv1_client",
    "name": "Disable SMBv1 Client Driver",
    "description": "Unloads the SMBv1 client driver (mrxdaf.sys) so this PC cannot be used as a conduit to spread SMB exploits to other machines.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "service",
        "name": "mrxsmb10",
        "start_type": "disabled"
      }
    ]
  },
  {
    "id": "disable_unrestricted_uac_elevate",
    "name": "Disable UAC Elevation on Remote Connections",
    "description": "Prevents programs from automatically elevating when launched via a remote desktop session. Closes an elevation attack vector in RDP scenarios.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\User Account Control",
        "value": "AllowRemoteRemoteRPCCalls",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "ConsentPromptBehaviorRemote",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_smart_screen_filter",
    "name": "Enable SmartScreen Filter (All Users)",
    "description": "Enables Windows SmartScreen for all users via policy — checks downloaded files and web content against a Microsoft reputation database.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "value": "EnableSmartScreen",
        "data": 1,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "value": "ShellSmartScreenLevel",
        "data": "Block",
        "kind": "SZ"
      }
    ]
  },
  {
    "id": "disable_loading_drivers_test",
    "name": "Turn Off Driver Test Signing",
    "description": "Turns off boot test-signing mode, so Windows will only load kernel drivers carrying a valid Microsoft signature. Test signing is normally only on if a developer tool or a driver installer switched it on.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "command",
        "cmd": "bcdedit /set testsigning off"
      }
    ],
    "detect": {
      "type": "powershell",
      "script": "$o = bcdedit /enum '{current}' | Out-String; if ($o -match '(?m)^\\s*testsigning\\s+Yes\\s*$') {'False'} else {'True'}",
      "applied_when": "True",
      "applied_reason": "boot test signing is off",
      "not_applied_reason": "boot test signing is on"
    }
  },
  {
    "id": "disable_smb_encryption",
    "name": "Require SMB Encryption on All Shares",
    "description": "Requires SMB encryption for all file shares — prevents any unencrypted SMB connection. Clients must support SMB3.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
        "value": "SMBServerNameHardeningLevel",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_admin_ads",
    "name": "Disable Admin Approval Mode Bypass for COM",
    "description": "Prevents COM objects from bypassing the Admin Approval Mode UAC prompt.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "FilterAdministratorToken",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_wsh_credential_prompt",
    "name": "Disable Credential Prompt for WSH Scripts",
    "description": "Requires WSH scripts to run without elevated privileges unless explicitly requested.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows Script Host\\Settings",
        "value": "AuthenticodePrompt",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "disable_office_file_validation",
    "name": "Disable Office File Validation for Faster Loading",
    "description": "Disables the Office File Validation inspector that scans downloaded files. Minor security reduction but faster file opening.",
    "category": "Security",
    "risk": "medium",
    "requires_admin": false,
    "steps": [
      {
        "type": "registry",
        "key": "HKCU\\SOFTWARE\\Microsoft\\Office\\16.0\\Common\\Security",
        "value": "DisableBrokerImplicitSigning",
        "data": 1,
        "kind": "DWORD"
      }
    ]
  },
  {
    "id": "enable_windows_defender_heaps",
    "name": "Enable Windows Defender Heap Protection",
    "description": "Enables all Windows Defender exploit protection heap mitigations.",
    "category": "Security",
    "risk": "low",
    "requires_admin": true,
    "steps": [
      {
        "type": "command",
        "cmd": "powershell -Command \"Set-ProcessMitigation -System -Enable HeapTurbo\""
      }
    ],
    "detect": {
      "type": "powershell",
      "script": "try { $m = Get-ProcessMitigation -System -ErrorAction Stop; if ($m.Heap.TerminateOnError -eq 'ON') {'True'} else {'False'} } catch { 'error' }",
      "applied_when": "True",
